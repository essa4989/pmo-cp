DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-long-random-secret-in-production"

# Optional: enables the AI Study Assistant's generative synthesis layer.
# Without it, the assistant still works fully in retrieval-only mode
# (grounded curriculum matches, no invented text) — this key only adds a
# short generated summary on top of the same grounded matches.
ANTHROPIC_API_KEY=""

# Web Push (study reminders). Generate your own pair for production with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Shared secret required by /api/cron/reminders so only your scheduler can
# trigger reminder pushes.
CRON_SECRET="replace-with-a-random-secret"

# Site-wide access gate: when set, EVERY page (landing, login, register —
# everything) redirects to /enter until the visitor types this exact code.
# Share it only with people you've approved; leave unset to make the site
# fully public.
SITE_ACCESS_CODE=""
