# PostgreSQL — the app needs a real database that persists across deploys
# (SQLite's local file doesn't survive on most hosting platforms). Point
# this at any Postgres: `docker compose up -d` starts one locally (see
# docker-compose.yml), or use a free hosted instance (Neon, Supabase,
# Vercel Postgres, Railway Postgres, ...).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pmocp"
JWT_SECRET="replace-with-a-long-random-secret-in-production"

# Optional: enables the AI Study Assistant's generative synthesis layer.
# Without it, the assistant still works fully in retrieval-only mode
# (grounded curriculum matches, no invented text) — this key only adds a
# short generated summary on top of the same grounded matches.
ANTHROPIC_API_KEY=""

# Web Push (study reminders). Generate your own pair for production with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Shared secret required by /api/cron/reminders so only your scheduler can
# trigger reminder pushes.
CRON_SECRET="replace-with-a-random-secret"

# Optional: overrides the base URL printed on generated certificates (e.g.
# the verification link). On Vercel this is auto-detected from the
# deployment's own domain, so you only need to set this for a custom domain.
NEXT_PUBLIC_SITE_URL=""
